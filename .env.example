# Runtime role of this installation: source or target
HTP_ROLE=source

# Local application bind settings
HTP_HOST=0.0.0.0
HTP_PORT=8080

# Local Harbor only. Each isolated contour points to its own Harbor.
HARBOR_URL=https://harbor.local.example
HARBOR_USERNAME=replace-me
HARBOR_PASSWORD=replace-me
HARBOR_CA_FILE=/etc/harbor-transfer-portal/ca.crt

# Application state
HTP_DATABASE_URL=sqlite:///data/harbor-transfer-portal.db
HTP_DATA_DIR=./data

# Logging
HTP_LOG_LEVEL=INFO
