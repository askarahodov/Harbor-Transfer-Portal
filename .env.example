# Контур этой установки. Допустимые значения: SOURCE или TARGET.
PORTAL_CONTOUR=SOURCE

# HTTP-порт, публикуемый frontend reverse proxy.
PORTAL_HTTP_PORT=8080

# Локальный тег образов, используемый Docker Compose.
PORTAL_VERSION=dev

# Только локальный Harbor текущего изолированного контура.
# Значения ниже являются bootstrap fallback и могут быть переопределены admin UI без рестарта.
HARBOR_URL=https://harbor.local.example
HARBOR_USER=replace-with-local-harbor-user
HARBOR_VERIFY_TLS=true

# Предпочтительно передавать credential через file-backed secret, смонтированный в backend.
# HARBOR_PASSWORD_FILE=/run/secrets/harbor_password
# Environment credential поддерживается только для bootstrap compatibility и не рекомендуется
# как постоянное хранилище нового production-развёртывания.
# HARBOR_PASSWORD=

# Portal-managed credential и CA после изменения через admin UI сохраняются в persistent volume.
HARBOR_MANAGED_SECRET_FILE=./data/secrets/harbor-password
HARBOR_MANAGED_CA_FILE=./data/secrets/harbor-ca.pem
HARBOR_CA_MAX_BYTES=262144

# Необязательный deployment-managed CA fallback внутри backend-контейнера.
# HARBOR_CA_FILE=/run/secrets/harbor-ca.pem
HARBOR_CONNECT_TIMEOUT_SECONDS=5
HARBOR_READ_TIMEOUT_SECONDS=20

# Skopeo выполняется только backend-сервисом. Payload ограничен локальным data root,
# subprocess имеет bounded timeout, а stdout/stderr сохраняются только до указанного лимита.
SKOPEO_BINARY=skopeo
SKOPEO_TIMEOUT_SECONDS=300
SKOPEO_OUTPUT_LIMIT_BYTES=65536
SKOPEO_PAYLOAD_ROOT=./data
SKOPEO_TEMP_ROOT=./data/tmp

# Локальное состояние SQLite в persistent volume /app/data.
DATABASE_URL=sqlite:///./data/harbor-transfer-portal.db

# Аутентификация. Сгенерируйте отдельный случайный секрет для каждой установки.
# JWT_SECRET намеренно не заполнен; требуется не менее 32 случайных символов.
# JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30

# Серверная защита входа. Счётчики не хранят пароли, токены, raw username или client address.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_USERNAME_MAX_FAILURES=5
LOGIN_RATE_LIMIT_ADDRESS_MAX_FAILURES=20
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=900

# Разрешённые browser origins в JSON. В штатной Compose-схеме запросы идут
# same-origin через Nginx, поэтому CORS по умолчанию не требуется.
CORS_ORIGINS=[]
