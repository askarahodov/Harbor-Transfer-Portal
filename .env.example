# Контур этой установки. Допустимые значения: SOURCE или TARGET.
PORTAL_CONTOUR=SOURCE

# HTTP-порт, публикуемый frontend reverse proxy.
PORTAL_HTTP_PORT=8080

# Локальный тег образов, используемый Docker Compose.
PORTAL_VERSION=dev

# Только локальный Harbor текущего изолированного контура.
# Значения ниже являются шаблонами и не должны использоваться в production.
HARBOR_URL=https://harbor.local.example
HARBOR_USER=replace-with-local-harbor-user
HARBOR_PASSWORD=replace-with-local-harbor-password
HARBOR_VERIFY_TLS=true
# Необязательный путь к доверенному CA внутри backend-контейнера.
# Для Compose удобно разместить CA в persistent volume, например /app/data/harbor-ca.crt.
# HARBOR_CA_FILE=/app/data/harbor-ca.crt
HARBOR_CONNECT_TIMEOUT_SECONDS=5
HARBOR_READ_TIMEOUT_SECONDS=20

# Локальное состояние SQLite в persistent volume /app/data.
DATABASE_URL=sqlite:///./data/harbor-transfer-portal.db

# Аутентификация. Сгенерируйте отдельный случайный секрет для каждой установки.
# JWT_SECRET намеренно не заполнен; требуется не менее 32 случайных символов.
# JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30

# Разрешённые browser origins в JSON. В штатной Compose-схеме запросы идут
# same-origin через Nginx, поэтому CORS по умолчанию не требуется.
CORS_ORIGINS=[]
