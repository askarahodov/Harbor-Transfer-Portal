# Runtime contour of this installation: SOURCE or TARGET
PORTAL_CONTOUR=SOURCE

# Local backend bind settings
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8000

# Local Harbor only. Each isolated contour points to its own Harbor.
HARBOR_URL=https://harbor.local.example
HARBOR_USER=replace-me
HARBOR_PASSWORD=replace-me
HARBOR_CA_FILE=/etc/harbor-transfer-portal/ca.crt
HARBOR_TLS_VERIFY=true

# Application state
PORTAL_DATABASE_URL=sqlite:///data/harbor-transfer-portal.db
PORTAL_DATA_DIR=./data

# Logging
PORTAL_LOG_LEVEL=INFO
