# Runtime contour for this installation. Allowed values: SOURCE or TARGET.
PORTAL_CONTOUR=SOURCE

# Local Harbor only. Each isolated contour points to its own Harbor.
# Credentials below are placeholders, never production values.
HARBOR_URL=https://harbor.local.example
HARBOR_USER=replace-with-local-harbor-user
HARBOR_PASSWORD=replace-with-local-harbor-password

# Local SQLite state.
DATABASE_URL=sqlite:///./data/harbor-transfer-portal.db

# Authentication. Generate a unique high-entropy value per installation.
# JWT_SECRET is intentionally not populated in this template; set at least 32 random characters.
# JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=30

# Optional browser origins, encoded as JSON. Empty means CORS middleware is disabled.
CORS_ORIGINS=[]
