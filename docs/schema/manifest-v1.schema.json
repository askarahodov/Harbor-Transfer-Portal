{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-transfer-portal.local/schema/manifest-v1.schema.json",
  "title": "Harbor Transfer Portal Bundle Manifest v1",
  "type": "object",
  "required": ["schema_version", "delivery_id", "created_at", "created_by", "source", "artifacts"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "delivery_id": {"type": "string", "pattern": "^DELIVERY-[0-9]{8}-[A-Z0-9]{6,32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1},
    "comment": {"type": ["string", "null"], "maxLength": 2000},
    "source": {
      "type": "object",
      "required": ["contour", "harbor"],
      "properties": {
        "contour": {"const": "SOURCE"},
        "harbor": {"type": "string", "minLength": 1},
        "portal_version": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/containerImage"},
          {"$ref": "#/$defs/helmChart"}
        ]
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["payload_path", "payload_sha256", "payload_size"],
      "properties": {
        "payload_path": {"type": "string", "minLength": 1},
        "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "payload_size": {"type": "integer", "minimum": 0}
      }
    },
    "containerImage": {
      "allOf": [
        {"$ref": "#/$defs/payload"},
        {
          "type": "object",
          "required": ["type", "repository", "reference", "source_digest"],
          "properties": {
            "type": {"const": "container-image"},
            "repository": {"type": "string", "minLength": 1},
            "reference": {"type": "string", "minLength": 1},
            "source_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      ]
    },
    "helmChart": {
      "allOf": [
        {"$ref": "#/$defs/payload"},
        {
          "type": "object",
          "required": ["type", "repository", "name", "version"],
          "properties": {
            "type": {"const": "helm-chart"},
            "repository": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "source_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      ]
    }
  }
}
